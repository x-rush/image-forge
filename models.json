{
  "$comment": "Model registry for image-forge. Providers implement providers/*.mjs; adding a model = add a JSON entry, no code changes. price_usd is per 1K image, edit_extra_usd is the per-input-image surcharge.",
  "default_provider": "fal",
  "providers": {
    "fal": {
      "description": "fal.ai gateway (sync REST, per-image billing)",
      "auth_env": "FAL_KEY",
      "docs": "https://fal.ai"
    },
    "replicate": {
      "description": "Replicate (async prediction API)",
      "auth_env": "REPLICATE_API_TOKEN",
      "docs": "https://replicate.com/docs",
      "setup": "See providers/replicate.mjs header — token file or env var"
    }
  },
  "models": {
    "nb21": {
      "provider": "fal",
      "vendor": "Google",
      "model": "Nano Banana 2.1",
      "endpoint": "google/nano-banana-2.1",
      "edit_endpoint": "google/nano-banana-2.1/edit",
      "best_for": "photo retouching / in-place editing (SSIM 0.97, highest)",
      "params": {
        "aspect_ratios": [
          "21:9",
          "16:9",
          "3:2",
          "4:3",
          "5:4",
          "1:1",
          "4:5",
          "3:4",
          "2:3",
          "9:16",
          "4:1",
          "1:4"
        ],
        "resolutions": [
          "1K",
          "2K",
          "4K"
        ],
        "seed": true,
        "quality": null,
        "background": false,
        "output_format": [
          "jpeg",
          "png",
          "webp"
        ]
      },
      "price_usd": 0.08,
      "price_multiplier_by_resolution": {
        "2K": 1.5,
        "4K": 2
      }
    },
